# ---------------------------------------------------------------
# MyPantryPal environment variables
# Copy this file to .env.local and fill in the values you have.
# Every integration is optional: without keys the app runs in
# demo mode (data saved in the browser) with manual fallbacks.
# ---------------------------------------------------------------

# Supabase (authentication, PostgreSQL database, image storage)
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Name of the private storage bucket for fridge and receipt photos.
NEXT_PUBLIC_SUPABASE_BUCKET=uploads

# OpenAI (fridge photo recognition, receipt OCR, AI tips and recipes)
# Server-side only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini

# USDA FoodData Central (nutrition lookup) - https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Optional grocery partner API for real prices and coupons.
# Leave empty to use clearly labeled demo coupons and sample prices.
GROCERY_PARTNER_API_URL=
GROCERY_PARTNER_API_KEY=
